# Demo values for the local emulators. Safe to commit — contains no secrets.

VITE_FIREBASE_API_KEY=demo-api-key
# Fake key. The emulators don't check it and never reach the internet.

VITE_FIREBASE_AUTH_DOMAIN=demo-ba-dashboard.firebaseapp.com
# Fake auth domain matching the demo project ID below.

VITE_FIREBASE_PROJECT_ID=demo-ba-dashboard
# The "demo-" prefix tells the Firebase SDKs and emulators this is not a real project.

VITE_FIREBASE_APP_ID=demo-app-id
# Fake app ID; unused by the emulators.

VITE_USE_EMULATORS=true
# Points the app at the local Auth/Firestore emulators instead of real Firebase.

VITE_APP_NAME=BA Dashboard
# Shown in the app header and browser title during local development.

VITE_APP_LOGO_URL=
# Optional: URL to a logo image. Empty by default for local development.

VITE_APP_PRIMARY_COLOR=
# Optional: hex accent color. Empty by default for local development.

VITE_APP_HINT_DOMAIN=
# Optional Google sign-in domain hint. Empty — the seed data uses several domains.
