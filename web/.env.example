# Copy to `.env.production.local` for your real Firebase project. Never commit that file.

# Firebase web config: Console → Project settings → General → Your apps → Web app.
VITE_FIREBASE_API_KEY=
# Firebase web config: apiKey. Not a secret — sent to every browser; security comes from
# Security Rules, Auth authorized domains, and API-key website restrictions (Phase 9).

VITE_FIREBASE_AUTH_DOMAIN=
# Firebase web config: authDomain (usually <project-id>.firebaseapp.com).

VITE_FIREBASE_PROJECT_ID=
# Firebase web config: projectId — your real project ID.

VITE_FIREBASE_APP_ID=
# Firebase web config: appId.

VITE_USE_EMULATORS=false
# Set to "false" in production so the app talks to real Firebase, not the local emulators.

VITE_APP_NAME=BA Dashboard
# Shown in the app header and browser title. Change for your organization's branding.

VITE_APP_LOGO_URL=
# Optional: URL to a logo image shown in the app header. Leave empty for text-only.

VITE_APP_PRIMARY_COLOR=
# Optional: hex color (e.g. #2563eb) used as the app's accent color. Leave empty for the default.
