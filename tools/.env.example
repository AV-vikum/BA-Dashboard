# Copy to `tools/.env.production` when going live (Phase 9). GOOGLE_APPLICATION_CREDENTIALS
# must point to a file OUTSIDE this repository.

FIREBASE_PROJECT_ID=my-company-reports
# Your real Firebase project ID. Emulator default (used when this file is absent): demo-ba-dashboard.

GOOGLE_APPLICATION_CREDENTIALS=C:\secure\ba-dashboard\service-account.json
# Absolute path to the downloaded service-account JSON key. Production only — never inside this repo.

APP_URL=https://my-company-reports.web.app
# Base URL of the deployed app, used to print report links. Emulator default: http://localhost:5173.

REPORTS_DIR=../reports
# Path to the local reports folder, relative to the repo root. Default: reports.

PUBLISHER_EMAIL=you@company.com
# Email recorded on `updatedBy` as "cli:<email>" when publishing from this machine.

FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# Emulator only — set automatically by the emulator scripts. Leave unset in production.
