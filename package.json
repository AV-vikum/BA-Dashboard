{
  "name": "ba-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "report": "tsx tools/src/cli.ts",
    "emulators": "node scripts/emulators.mjs --only auth,firestore",
    "emulators:all": "node scripts/emulators.mjs",
    "emulators:reset": "node scripts/emulators-reset.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepare": "lefthook install",
    "secrets:scan": "secretlint \"**/*\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.30.2",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
