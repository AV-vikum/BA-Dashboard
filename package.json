{
  "name": "ba-dashboard",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "web",
    "tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n emulators,web -c yellow,cyan \"npm run emulators\" \"npm run dev -w web\"",
    "build": "npm run build --workspaces --if-present",
    "report": "tsx tools/src/cli.ts",
    "emulators": "node scripts/emulators.mjs --only auth,firestore",
    "emulators:all": "node scripts/emulators.mjs",
    "emulators:reset": "node scripts/emulators-reset.mjs",
    "preview:hosting": "npm run build:emulator -w web && concurrently -n emulators,preview -c yellow,cyan \"node scripts/emulators.mjs --only auth,firestore\" \"npm run preview -w web\"",
    "setup": "tsx tools/src/scripts/setup.ts",
    "seed": "tsx tools/src/scripts/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rules": "firebase emulators:exec --only firestore --project demo-ba-dashboard-rules \"vitest run --config tests/rules/vitest.config.ts\"",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test",
    "prepare": "lefthook install",
    "secrets:scan": "secretlint \"**/*\"",
    "test:tools:int": "node scripts/test-tools-int.mjs",
    "build:tools": "npm run build -w tools",
    "mcp": "node tools/dist/mcp.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.5",
    "concurrently": "^10.0.5",
    "csv-parse": "^7.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.30.2",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "prettier": "^3.9.9",
    "secretlint": "^13.0.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
